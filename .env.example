# ---- Base de datos (PostgreSQL) ----
# Vercel Postgres/Neon: copia POSTGRES_URL. Supabase: usa la cadena "Session pooler" (puerto 5432/6543).
DATABASE_URL=postgres://usuario:clave@localhost:5432/bonsai_zen
# Activa SSL para Neon/Supabase (true) o déjalo en false para Postgres local.
DATABASE_SSL=false

# ---- Stripe (modo test) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Precio (one-time) del modo Premium creado en el dashboard de Stripe en modo test.
NEXT_PUBLIC_STRIPE_PRICE_ID=price_xxx
# URL pública de la app (para las redirecciones de Stripe Checkout).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Sesiones ----
# Solo para producción: si está definido, la cookie se marca como Secure.
SESSION_COOKIE_SECURE=false
